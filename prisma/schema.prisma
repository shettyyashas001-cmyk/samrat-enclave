generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Enquiry {
  id                Int      @id @default(autoincrement())
  name              String
  phone             String
  email             String?  // Made optional so submissions without email succeed
  preferredLocation String   @default("Bengaluru")
  propertyType      String   @default("Villa Plots")
  budgetRange       String   @default("Flexible")
  dimensions        String   @default("Standard")
  notes             String?
  status            String   @default("NEW")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Property {
  id                Int      @id @default(autoincrement())
  title             String
  slug              String   @unique
  location          String
  dimensions        String
  priceStartingFrom String
  reraNumber        String?
  description       String?
  features          String   @default("[]")
  brochureUrl       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}